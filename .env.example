# ---------------------------------------------------------------------------
# Discogs Player — variables d'environnement
# Copier en .env.local (web) / .env (docker compose). Aucune valeur sensible ici.
# Toutes les variables sont validées au démarrage (src/lib/env.ts, Zod).
# ---------------------------------------------------------------------------

# --- Base ---
NODE_ENV=development
PORT=3004
APP_BASE_URL=http://localhost:3004
DATABASE_URL=postgres://discogs:discogs@localhost:5433/discogs_player
LOG_LEVEL=info

# --- Sessions & chiffrement ---
# SESSION_SECRET : uniquement pour signer les états OAuth court-terme (pas les sessions,
# qui sont des jetons opaques hachés en base). 32+ octets base64.
SESSION_SECRET=
# CREDENTIAL_ENCRYPTION_KEY : AES-256-GCM, 32 octets en base64.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
SESSION_IDLE_TTL_HOURS=720
SESSION_ABSOLUTE_TTL_HOURS=2160

# --- Discogs ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_CALLBACK_URL=http://localhost:3004/api/auth/discogs/callback
# User-Agent obligatoire pour l'API Discogs (sinon 403).
DISCOGS_USER_AGENT="DiscogsPlayer/0.1 +http://localhost:3004"
# Développement local uniquement — jamais en production.
DISCOGS_PERSONAL_TOKEN=

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
# Quota exprimé en UNITÉS (un seul compartiment partagé côté Google).
# search.list = 100 unités, videos.list = 1 unité.
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_SEARCH_UNIT_COST=100
YOUTUBE_VIDEOS_UNIT_COST=1
# Réserve de sécurité laissée libre pour les validations videos.list.
YOUTUBE_SEARCH_RESERVE_UNITS=1000
YOUTUBE_QUOTA_RESET_TIMEZONE=America/Los_Angeles
# Durée de vie maximale d'un cache de métadonnées fournisseur (politique YouTube : 30 j).
PROVIDER_METADATA_MAX_AGE_DAYS=30

# --- Spotify (v0 : Embed + oEmbed uniquement, aucune clé requise) ---
SPOTIFY_OEMBED_URL=https://open.spotify.com/oembed

# --- Administration ---
# Liste d'IDs numériques Discogs séparés par des virgules.
ADMIN_DISCOGS_USER_IDS=

# --- Worker ---
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_SECONDS=300

# --- Anti-abus (valeurs par défaut, cf. docs/SPEC-GAPS.md G-02) ---
RATELIMIT_PROPOSALS_PER_DAY=50
RATELIMIT_CONFIRMATIONS_PER_DAY=100
RATELIMIT_SYNC_PER_DAY=10

# --- Mode fournisseurs simulés (développement sans clés) ---
PROVIDERS_MODE=live
# live | fixtures ; fixtures remplace uniquement les adaptateurs externes.
FIXTURES_LATENCY_MS=0
FIXTURES_ERROR_RATE=0
